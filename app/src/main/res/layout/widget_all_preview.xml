<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_panel_preview"
        android:orientation="vertical"
        android:padding="@dimen/widget_panel_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_button_size"
            android:layout_marginVertical="@dimen/widget_row_spacing"
            android:background="@drawable/widget_pill_background"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/widget_bar_padding">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/widget_key_size"
                    android:layout_height="@dimen/widget_key_size"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_key_background"
                    android:contentDescription="@string/key_power"
                    android:padding="@dimen/widget_key_padding"
                    android:src="@drawable/ic_power"
                    android:tint="@color/widget_content" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/widget_key_size"
                    android:layout_height="@dimen/widget_key_size"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_key_background"
                    android:contentDescription="@string/key_screen_off"
                    android:padding="@dimen/widget_key_padding"
                    android:src="@drawable/ic_screen_off"
                    android:tint="@color/widget_content" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/widget_key_size"
                    android:layout_height="@dimen/widget_key_size"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_key_background"
                    android:contentDescription="@string/key_screen_on"
                    android:padding="@dimen/widget_key_padding"
                    android:src="@drawable/ic_screen_on"
                    android:tint="@color/widget_content" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/widget_key_size"
                    android:layout_height="@dimen/widget_key_size"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_key_background"
                    android:contentDescription="@string/key_mute"
                    android:padding="@dimen/widget_key_padding"
                    android:src="@drawable/ic_volume_off"
                    android:tint="@color/widget_content" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_button_size"
            android:layout_marginVertical="@dimen/widget_row_spacing"
            android:background="@drawable/widget_pill_background"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/widget_bar_padding">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/widget_key_size"
                    android:layout_height="@dimen/widget_key_size"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_key_background"
                    android:contentDescription="@string/key_volume_up"
                    android:padding="@dimen/widget_key_padding"
                    android:src="@drawable/ic_plus"
                    android:tint="@color/widget_content" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/widget_key_size"
                    android:layout_height="@dimen/widget_key_size"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_key_background"
                    android:contentDescription="@string/key_volume_down"
                    android:padding="@dimen/widget_key_padding"
                    android:src="@drawable/ic_minus"
                    android:tint="@color/widget_content" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/widget_key_size"
                    android:layout_height="@dimen/widget_key_size"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_key_background"
                    android:contentDescription="@string/key_channel_up"
                    android:padding="@dimen/widget_key_padding"
                    android:src="@drawable/ic_chevron_up"
                    android:tint="@color/widget_content" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/widget_key_size"
                    android:layout_height="@dimen/widget_key_size"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_key_background"
                    android:contentDescription="@string/key_channel_down"
                    android:padding="@dimen/widget_key_padding"
                    android:src="@drawable/ic_chevron_down"
                    android:tint="@color/widget_content" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/widget_button_size"
            android:layout_marginVertical="@dimen/widget_row_spacing"
            android:background="@drawable/widget_pill_background"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/widget_bar_padding">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/widget_key_size"
                    android:layout_height="@dimen/widget_key_size"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_key_background"
                    android:contentDescription="@string/key_rewind"
                    android:padding="@dimen/widget_key_padding"
                    android:src="@drawable/ic_fast_rewind"
                    android:tint="@color/widget_content" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/widget_key_size"
                    android:layout_height="@dimen/widget_key_size"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_key_background"
                    android:contentDescription="@string/key_play"
                    android:padding="@dimen/widget_key_padding"
                    android:src="@drawable/ic_play"
                    android:tint="@color/widget_content" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/widget_key_size"
                    android:layout_height="@dimen/widget_key_size"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_key_background"
                    android:contentDescription="@string/key_pause"
                    android:padding="@dimen/widget_key_padding"
                    android:src="@drawable/ic_pause"
                    android:tint="@color/widget_content" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/widget_key_size"
                    android:layout_height="@dimen/widget_key_size"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_key_background"
                    android:contentDescription="@string/key_fast_forward"
                    android:padding="@dimen/widget_key_padding"
                    android:src="@drawable/ic_fast_forward"
                    android:tint="@color/widget_content" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="@dimen/widget_key_size"
                    android:layout_height="@dimen/widget_key_size"
                    android:layout_gravity="center"
                    android:background="@drawable/widget_key_background"
                    android:contentDescription="@string/key_stop"
                    android:padding="@dimen/widget_key_padding"
                    android:src="@drawable/ic_stop"
                    android:tint="@color/widget_content" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
