<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="@dimen/widget_rocker_width"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/widget_pill_background"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/widget_channel_up"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/key_channel_up"
            android:padding="@dimen/widget_key_padding"
            android:src="@drawable/ic_chevron_up"
            android:tint="@color/widget_content" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/key_channel"
            android:textColor="@color/widget_content"
            android:textSize="@dimen/widget_text_size"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/widget_channel_down"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:contentDescription="@string/key_channel_down"
            android:padding="@dimen/widget_key_padding"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/widget_content" />
    </LinearLayout>
</FrameLayout>
